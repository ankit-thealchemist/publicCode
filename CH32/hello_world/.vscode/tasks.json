{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake-configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "build",
            "type": "shell",
            "command": "make",
            "args": [
                "-j$(nproc)"
            ],
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": [
                "cmake-configure"
            ],
            "dependsOrder": "sequence"
        },
        {
            "label": "flash",
            "type": "shell",
            "command": "${env:CH32_OPENOCD_PATH}/bin/openocd",
            "args": [
                "-f",
                "${env:CH32_OPENOCD_PATH}/bin/wch-riscv.cfg",
                "-c",
                "program ${workspaceFolder}/build/CH32_HelloWorld.elf verify reset exit"
            ],
            "group": "test",
            "problemMatcher": [],
            "dependsOn": [
                "build"
            ],
            "dependsOrder": "sequence"
        },
        {
            "type": "cmake",
            "label": "CMake: clean",
            "command": "clean",
            "problemMatcher": [],
            "detail": "CMake template clean task"
        },
        {
            "type": "cmake",
            "label": "CMake: clean rebuild",
            "command": "cleanRebuild",
            "targets": [
                "all"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "CMake template clean rebuild task"
        },
        {
            "type": "cmake",
            "label": "CMake: configure",
            "command": "configure",
            "problemMatcher": [],
            "detail": "CMake template configure task"
        }
    ]
}
